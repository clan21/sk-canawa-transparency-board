{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sk-canawa-transparency-board",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-12",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sk-canawa-transparency-db",
      "database_id": "389c744a-3b97-45b2-a386-4969a3f4f0af",
      "preview_database_id": "DB"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCS_BUCKET",
      "bucket_name": "sk-canawa-documents",
      "preview_bucket_name": "sk-canawa-documents"
    }
  ]
}
